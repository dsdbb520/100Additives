  m_Script: {fileID: 11500000, guid: c60b54a6afd86224e953db97019a654a, type: 3}
  m_Name: "\u5730\u6C9F\u6CB9\u6CC4\u6F0F"
  m_EditorClassIdentifier: 
  eventID: GutterOil
  title: "\u5730\u6C9F\u6CB9\u6CC4\u6F0F"
  eventImage: {fileID: 21300000, guid: f6a62801e0660d547b808f4b2a231197, type: 3}
  dialogueLines:
  - "\uFF08\u5494\u5693\u2014\u2014\u811A\u4E0B\u7684\u5730\u677F\u7A81\u7136\u788E\u88C2\uFF0C\u5931\u91CD\u611F\u77AC\u95F4\u88AD\u6765\uFF09"
  - "\u54B3\u54B3\uFF01\u5455\u2026\u2026\u597D\u81ED\uFF01\u4F60\u6389\u8FDB\u4E86\u4E00\u4E2A\u79EF\u6EE1\u9ED1\u8272\u7C98\u7A20\u6DB2\u4F53\u7684\u5E9F\u5F03\u50A8\u6CB9\u5751\uFF0C\u4EE4\u4EBA\u7A92\u606F\u7684\u9178\u8150\u5473\u76F4\u51B2\u5929\u7075\u76D6\u3002"
  - "\u8FD9\u79CD\u6F06\u9ED1\u7684\u6D41\u4F53\u50CF\u662F\u6709\u751F\u547D\u4E00\u822C\uFF0C\u8FC5\u901F\u6D78\u900F\u4E86\u4F60\u7684\u8863\u7269\uFF0C\u4E5F\u6C61\u67D3\u4E86\u4F60\u8F9B\u82E6\u6536\u96C6\u7684\u98DF\u6750\u3002"
  - "\u4F60\u5728\u7C98\u6DB2\u4E2D\u72FC\u72C8\u6323\u624E\uFF0C\u5374\u9690\u7EA6\u770B\u89C1\u5728\u90A3\u6076\u5FC3\u7684\u9ED1\u8272\u6DF1\u5904\uFF0C\u4F3C\u4E4E\u6F02\u6D6E\u7740\u4EC0\u4E48\u4EAE\u95EA\u95EA\u7684\u4E1C\u897F\u2026\u2026"
  options:
  - description: "\u3010 \u751A \u81F3 \u635E \u4E86 \u4E00 \u628A \u3011"
    hoverText: "\u83B7\u5F97\u4E00\u5F20\u8BC5\u5492\u724C <color=#00FFFF><b>\u3010\u5730\u6C9F\u6CB9\u3011</b></color>\u3002\u83B7\u5F97
      <color=red>50</color> \u91D1\u5E01\u3002 "
  - description: "\u3010 \u72FC \u72C8 \u722C \u51FA \u3011"
    hoverText: "\u5931\u53BB <color=red>10%</color> \u5F53\u524D\u751F\u547D\u503C\u3002 "
  - description: "\u3010 \u73B0 \u573A \u63D0 \u70BC \u3011"
    hoverText: "\u83B7\u5F97<color=#00FFFF><b>\u3010\u4E00\u6EF4\u9999\u3011</b></color> "
