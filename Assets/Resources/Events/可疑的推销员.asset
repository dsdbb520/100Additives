  eventID: Salesman
  title: "\u53EF\u7591\u7684\u63A8\u9500\u5458"
  eventImage: {fileID: 21300000, guid: a1480dd524e652442a2e795bc088f83c, type: 3}
  dialogueLines:
  - "\u5618\u2014\u2014\u5C0F\u58F0\u70B9\uFF0C\u5927\u53A8\u3002\u536B\u751F\u5C40\u90A3\u5E2E\u2018\u82CD\u8747\u2019\u521A\u98DE\u8D70\uFF0C\u73B0\u5728\u5B89\u5168\u4E86\u3002"
  - "\uFF08\u4ED6\u731B\u5730\u62C9\u5F00\u98CE\u8863\uFF0C\u91CC\u9762\u6302\u6EE1\u4E86\u6B63\u5728\u8815\u52A8\u7684\u8089\u5757\u548C\u53D1\u51FA\u8367\u5149\u7684\u74F6\u5B50\uFF09"
  - "\u770B\u770B\u8FD9\u8272\u6CFD\uFF0C\u8FD9\u6D3B\u529B\u2026\u2026\u5E02\u9762\u4E0A\u7EDD\u5BF9\u4E70\u4E0D\u5230\u7684\u2018\u72E0\u8D27\u2019\uFF0C\u53EA\u6709\u61C2\u884C\u7684\u4EBA\u624D\u914D\u62E5\u6709\u3002"
  - "\u600E\u4E48\u6837\uFF1F\u4E0D\u60F3\u8BA9\u4F60\u7684\u83DC\u54C1\u66F4\u2018\u523A\u6FC0\u2019\u4E00\u70B9\u5417\uFF1F\u7ED9\u4F60\u4E2A\u5185\u90E8\u4EF7\u3002"
  options:
  - description: "\u3010 \u4E70 \u70B9 \u79D1 \u6280 \u3011"
    hoverText: "\u5931\u53BB <color=red>30</color> \u91D1\u5E01\u3002\u83B7\u5F97
      <color=red>1</color>  \u4E2A\u968F\u673A \u666E\u901A\u9057\u7269\u3002 "
  - description: "\u3010 \u4EE5 \u8EAB \u8BD5 \u836F \u3011"
    hoverText: " \u5931\u53BB <color=red>15</color> \u70B9\u751F\u547D\u503C\u3002\u5347\u7EA7\u724C\u5E93\u4E2D\u7684
      <color=red>2</color> \u5F20\u968F\u673A\u5361\u724C\u3002 "
  - description: "\u3010 \u4E0D \u9700 \u8981 \u3011"
    hoverText: 
