  m_Script: {fileID: 11500000, guid: c60b54a6afd86224e953db97019a654a, type: 3}
  m_Name: "\u7F51\u7EA2\u63A2\u5E97"
  m_EditorClassIdentifier: 
  eventID: Influencer
  title: "\u7F51\u7EA2\u63A2\u5E97"
  eventImage: {fileID: 21300000, guid: 9c0bb39d94d44f649876c359a92e87d3, type: 3}
  dialogueLines:
  - "\u54C8\u55BD\u5BB6\u4EBA\u4EEC\uFF01\u5927\u58F0\u544A\u8BC9\u6211\uFF0C\u4ECA\u5929\u6211\u4EEC\u6311\u6218\u7684\u76EE\u6807\u662F\u54EA\u91CC\uFF1F\u6CA1\u9519\uFF0C\u5C31\u662F\u8FD9\u5BB6\u4F20\u8BF4\u4E2D\u7684\u2018\u96F6\u5206\u98DF\u5802\u2019\uFF01"
  - "\uFF08\u624B\u673A\u955C\u5934\u51E0\u4E4E\u603C\u5230\u4E86\u4F60\u7684\u9F3B\u5B50\u4E0A\uFF09\u6765\uFF0C\u8001\u677F\u522B\u8EB2\u554A\uFF01\u7ED9\u76F4\u64AD\u95F4\u7684\u5144\u5F1F\u4EEC\u7B11\u4E00\u4E2A\uFF01\u5927\u5BB6\u628A\u2018\u4FDD\u62A4\u2019\u6253\u5728\u516C\u5C4F\u4E0A\uFF01"
  - "\u542C\u8BF4\u5403\u4E86\u4F60\u505A\u7684\u83DC\u80FD\u770B\u89C1\u592A\u5976\uFF1F\u771F\u7684\u5047\u7684\uFF1F\u6211\u4E0D\u4FE1\uFF01\u9664\u975E\u4F60\u73B0\u5728\u9732\u4E00\u624B\uFF01"
  - "\u6765\u6765\u6765\uFF0C\u54B1\u4EEC\u5F53\u573A\u5BF9\u8D4C\uFF01\u4F60\u8981\u662F\u80FD\u505A\u51FA\u4E00\u9053\u8BA9\u6211\u5FC3\u670D\u53E3\u670D\u7684\u83DC\uFF0C\u8FD9100\u91D1\u5E01\u7684\u2018\u5927\u706B\u7BAD\u2019\u6211\u5F53\u573A\u5C31\u5237\u7ED9\u4F60\uFF01"
  options:
  - description: "\u3010 \u5C55 \u793A \u5200 \u5DE5 \u3011"
    hoverText: "\u6210\u529F\u7387 <color=red>50%</color> \u3002 \u6210\u529F\uFF1A\u83B7\u5F97
      <color=red>100</color> \u91D1\u5E01 \u5931\u8D25\uFF1A\u83B7\u5F97\u8BC5\u5492\u724C<color=#00FFFF><b>\u3010\u5DEE\u8BC4\u3011</b></color> "
  - description: "\u3010\u8BF7\u4ED6\u5403\u201C\u7279\u8272\u83DC\u201D\u3011"
    hoverText: "\u8FDB\u5165\u4E00\u573A\u7CBE\u82F1\u6218\u6597\uFF0C\u4F46\u5927\u9505\u521D\u59CB\u538B\u529B
      <color=red>+50%</color> \u3002 \u80DC\u5229\u540E\u83B7\u5F97<color=#00FFFF><b>\u3010\u7A00\u6709\u9057\u7269\u3011</b></color>\u3002 "
  - description: "\u3010 \u8D76 \u51FA \u53BB \u3011"
    hoverText: "\u65E0\u4E8B\u53D1\u751F"
